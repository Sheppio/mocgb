# The service worker must never be cached by the browser, or phones miss new deploys.
/sw.js
  Cache-Control: no-cache

# The Flutter app's files (main.dart.js, flutter_bootstrap.js) keep the same names between builds,
# so browsers must check for a new version every time. The two Cross-Origin headers isolate the
# page, so the WebAssembly build can render on several threads.
/app/*
  Cache-Control: no-cache
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Proof of concept: keep every address (production and Previews) out of search engines.
# Remove this rule when the site goes public.
/*
  X-Robots-Tag: noindex
